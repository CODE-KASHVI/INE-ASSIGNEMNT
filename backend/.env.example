# Copy this file to backend/.env for local development.
# On Render, set these as real environment variables in the service's dashboard instead.

NODE_ENV=development
PORT=5000

# --- Supabase -----------------------------------------------------------------
# Project Settings → API. Use the service_role key (server-only — never send this to the
# frontend). The anon key will NOT work: every table has RLS enabled with no policies.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- CORS -----------------------------------------------------------------------
# Exact origin of the deployed (or local) frontend. No wildcard, no trailing slash.
FRONTEND_URL=http://localhost:5173

# --- cron-job.org ---------------------------------------------------------------
# Generate a long random value, e.g.: openssl rand -hex 32
# Configure cron-job.org to send: Authorization: Bearer <this value>
CRON_SECRET=

# --- Scraper tuning (all optional — sensible defaults shown) --------------------
SCRAPER_HEADLESS=true
SCRAPER_MAX_RETRIES=3
SCRAPER_NAVIGATION_TIMEOUT_MS=30000
SCRAPER_SELECTOR_TIMEOUT_MS=15000
SCRAPER_REVEAL_TIMEOUT_MS=20000
SCRAPER_CONCURRENCY=3

# --- Scheduling / dedup tuning (all optional) ------------------------------------
SCRAPE_INTERVAL_HOURS_DEFAULT=2
SCRAPE_DUE_GRACE_SECONDS=600
SCRAPE_CRON_DEDUPE_WINDOW_SECONDS=3600
SCRAPE_RUN_STALE_SECONDS=900
SCRAPE_LOCK_TTL_SECONDS=300
